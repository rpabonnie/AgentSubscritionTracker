<!-- SPEC-0004 §5.2 — DARK editor-chrome brushes for the theme editor window itself (its own
     window/labels/fields/buttons). Distinct key namespace (Editor*) so it never collides with
     the edited-theme preview keys (CalloutBackgroundBrush, etc.). Must define the IDENTICAL key
     set as EditorChromeLight.xaml so a swap never leaves an unresolved DynamicResource. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="EditorWindowBackground" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="EditorPanelBackground" Color="#FF202020" />
    <SolidColorBrush x:Key="EditorText" Color="#FFEDEFF5" />
    <SolidColorBrush x:Key="EditorFieldBackground" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="EditorFieldBorder" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="EditorButtonBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="EditorButtonBorder" Color="#FF4A4A4A" />

</ResourceDictionary>
