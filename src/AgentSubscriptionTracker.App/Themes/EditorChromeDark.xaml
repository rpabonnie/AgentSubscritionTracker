<!-- SPEC-0004 §5.2 — DARK editor-chrome brushes for the theme-management windows themselves
     (their OWN look, NOT the theme being edited). Distinct Editor* namespace so it never
     collides with the edited-theme preview keys (CalloutBackgroundBrush, etc.). Must define the
     IDENTICAL key set as EditorChromeLight.xaml so the editor's Light/Dark swap (which replaces
     MergedDictionaries[0] wholesale) never leaves an unresolved DynamicResource.

     Palette: Catppuccin-Mocha-derived soft-dark surfaces with a single mauve accent — layered
     surface levels (mantle → base → card → field) instead of one flat gray, per the design
     system in EditorDesignSystem.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces (low → high) -->
    <SolidColorBrush x:Key="EditorWindowBackground" Color="#FF181825" />
    <SolidColorBrush x:Key="EditorPanelBackground" Color="#FF1E1E2E" />
    <SolidColorBrush x:Key="EditorCardBackground" Color="#FF262637" />
    <SolidColorBrush x:Key="EditorFieldBackground" Color="#FF313244" />

    <!-- Text -->
    <SolidColorBrush x:Key="EditorText" Color="#FFCDD6F4" />
    <SolidColorBrush x:Key="EditorSecondaryText" Color="#FFA6ADC8" />
    <SolidColorBrush x:Key="EditorTertiaryText" Color="#FF6C7086" />

    <!-- Borders / dividers -->
    <SolidColorBrush x:Key="EditorFieldBorder" Color="#FF45475A" />
    <SolidColorBrush x:Key="EditorBorderStrong" Color="#FF6C7086" />
    <SolidColorBrush x:Key="EditorDivider" Color="#26FFFFFF" />

    <!-- Neutral buttons -->
    <SolidColorBrush x:Key="EditorButtonBackground" Color="#FF313244" />
    <SolidColorBrush x:Key="EditorButtonBorder" Color="#FF45475A" />
    <SolidColorBrush x:Key="EditorButtonHover" Color="#FF3A3C52" />
    <SolidColorBrush x:Key="EditorButtonPressed" Color="#FF2A2C3D" />

    <!-- Accent (mauve) -->
    <SolidColorBrush x:Key="EditorAccent" Color="#FFCBA6F7" />
    <SolidColorBrush x:Key="EditorAccentHover" Color="#FFD3B4F9" />
    <SolidColorBrush x:Key="EditorAccentPressed" Color="#FFB892EF" />
    <SolidColorBrush x:Key="EditorAccentText" Color="#FF1E1E2E" />
    <SolidColorBrush x:Key="EditorAccentSubtle" Color="#28CBA6F7" />
    <SolidColorBrush x:Key="EditorOnAccentRing" Color="#66CBA6F7" />

    <!-- State -->
    <SolidColorBrush x:Key="EditorOk" Color="#FFA6E3A1" />
    <SolidColorBrush x:Key="EditorWarn" Color="#FFF9E2AF" />
    <SolidColorBrush x:Key="EditorDanger" Color="#FFF38BA8" />
    <SolidColorBrush x:Key="EditorDangerHover" Color="#FFF6A0B8" />
    <SolidColorBrush x:Key="EditorWarnSurface" Color="#1FF9E2AF" />
    <SolidColorBrush x:Key="EditorDangerSurface" Color="#1FF38BA8" />

</ResourceDictionary>
