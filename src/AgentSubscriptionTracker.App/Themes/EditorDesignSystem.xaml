<!-- Shared design system for the theme-management chrome (theme picker popup, theme editor
     window, RGBA color picker). Theme-INDEPENDENT tokens (spacing, radii, type ramp) + ALL
     keyed control templates live here and are merged once at App scope. The swappable colors
     live in EditorChromeDark.xaml / EditorChromeLight.xaml (the editor toggles between them at
     MergedDictionaries[0]); every brush below is referenced via DynamicResource so a chrome
     swap re-resolves it.

     ISOLATION CONTRACT: everything here is x:Key'd — there are NO implicit (keyless,
     TargetType-only) styles — so merging this app-wide never bleeds into the live callout
     preview (CalloutContent), which must keep rendering the *edited* theme. Windows opt in
     per-control via Style="{StaticResource ...}" or a scoped implicit style BasedOn these. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:AgentSubscriptionTracker.App.Views">

    <!-- ===================== Spacing scale (4px sub-grid / 8px rhythm) ===================== -->
    <Thickness x:Key="LabelToFieldGap">0,0,0,4</Thickness>
    <Thickness x:Key="RowGap">0,0,0,10</Thickness>
    <Thickness x:Key="CardPad">20</Thickness>
    <Thickness x:Key="CardGap">0,0,0,16</Thickness>
    <Thickness x:Key="WindowPad">20</Thickness>
    <Thickness x:Key="FieldPad">10,0,10,0</Thickness>
    <Thickness x:Key="ButtonPad">16,0,16,0</Thickness>

    <!-- ===================== Corner radii ===================== -->
    <CornerRadius x:Key="RadiusCtl">6</CornerRadius>
    <CornerRadius x:Key="RadiusCard">10</CornerRadius>
    <CornerRadius x:Key="RadiusOverlay">12</CornerRadius>
    <CornerRadius x:Key="RadiusSwatch">5</CornerRadius>

    <!-- ===================== Alpha checkerboard (under translucent swatches/sliders) =====================
         Absolute viewport + device-pixel snapping so the 6px tiles stay crisp at fractional DPI. -->
    <DrawingBrush x:Key="AlphaCheckerBrush" TileMode="Tile"
                  Viewport="0,0,12,12" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFFFFFF">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,12,12" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFC9CBD6">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,6,6" />
                            <RectangleGeometry Rect="6,6,6,6" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ===================== Surfaces ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource EditorCardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorDivider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
        <Setter Property="Padding" Value="{StaticResource CardPad}" />
        <Setter Property="Margin" Value="{StaticResource CardGap}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================== Type ramp (Segoe UI Variable on Win11, Segoe UI fallback) ===================== -->
    <Style x:Key="TextCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource EditorSecondaryText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="TextBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="TextBodyStrong" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TextSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
    </Style>
    <Style x:Key="TextTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
    </Style>
    <Style x:Key="TextSectionHeader" TargetType="TextBlock" BasedOn="{StaticResource TextSubtitle}">
        <Setter Property="Foreground" Value="{DynamicResource EditorAccent}" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ===================== Slider / scrollbar repeat buttons (invisible track halves) ===================== -->
    <Style x:Key="TrackRepeatButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Thin auto-hide-feel scrollbar thumb ===================== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="5" Margin="2,0"
                            Background="{DynamicResource EditorBorderStrong}" Opacity="0.45" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Opacity" Value="0.95" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackRepeatButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackRepeatButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Buttons =====================
         One template; variants differ only by their rest colors + the attached
         UiState hover/pressed brushes the triggers bind to. -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="{StaticResource ButtonPad}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
        <Setter Property="Background" Value="{DynamicResource EditorButtonBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="views:UiState.HoverBrush" Value="{DynamicResource EditorButtonHover}" />
        <Setter Property="views:UiState.PressedBrush" Value="{DynamicResource EditorButtonPressed}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bg" CornerRadius="{StaticResource RadiusCtl}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="ring" CornerRadius="{StaticResource RadiusCtl}"
                                Margin="-1" BorderThickness="2" BorderBrush="Transparent"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background"
                                    Value="{Binding Path=(views:UiState.HoverBrush), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background"
                                    Value="{Binding Path=(views:UiState.PressedBrush), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource EditorAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{DynamicResource EditorAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource EditorAccentText}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="views:UiState.HoverBrush" Value="{DynamicResource EditorAccentHover}" />
        <Setter Property="views:UiState.PressedBrush" Value="{DynamicResource EditorAccentPressed}" />
    </Style>

    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorButtonBorder}" />
        <Setter Property="views:UiState.HoverBrush" Value="{DynamicResource EditorButtonHover}" />
        <Setter Property="views:UiState.PressedBrush" Value="{DynamicResource EditorButtonPressed}" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource EditorDanger}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorButtonBorder}" />
        <Setter Property="views:UiState.HoverBrush" Value="{DynamicResource EditorDangerSurface}" />
        <Setter Property="views:UiState.PressedBrush" Value="{DynamicResource EditorDangerSurface}" />
    </Style>

    <!-- The clickable color chip: checkerboard under the (possibly translucent) color, hairline
         border, accent on hover/focus. Background is bound (by the consumer) to the field's hex. -->
    <Style x:Key="IconSwatchButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTip" Value="Pick a color" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border CornerRadius="{StaticResource RadiusSwatch}"
                                Background="{StaticResource AlphaCheckerBrush}" SnapsToDevicePixels="True" />
                        <Border x:Name="chip" CornerRadius="{StaticResource RadiusSwatch}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource EditorBorderStrong}"
                                BorderThickness="1" SnapsToDevicePixels="True" />
                        <Border x:Name="ring" CornerRadius="{StaticResource RadiusSwatch}"
                                Margin="-1" BorderThickness="2" BorderBrush="Transparent"
                                IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chip" Property="BorderBrush" Value="{DynamicResource EditorAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="ring" Property="BorderBrush" Value="{DynamicResource EditorAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== TextBox ===================== -->
    <Style x:Key="TextBoxBase" TargetType="TextBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="{StaticResource FieldPad}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
        <Setter Property="Background" Value="{DynamicResource EditorFieldBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorFieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource EditorText}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource EditorAccent}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" CornerRadius="{StaticResource RadiusCtl}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource EditorBorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource EditorAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The fix for the over-wide hex fields: content-sized, monospace, upper-cased. WPF hex is
         alpha-FIRST (#AARRGGBB / #RRGGBB), so MaxLength 9 covers the longest valid value. -->
    <Style x:Key="HexBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}">
        <Setter Property="Width" Value="116" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterCasing" Value="Upper" />
        <Setter Property="MaxLength" Value="9" />
    </Style>

    <Style x:Key="FontSizeBox" TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}">
        <Setter Property="Width" Value="64" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- ===================== ComboBox ===================== -->
    <Style x:Key="ThemedComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="ib" Margin="2,1" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ib" Property="Background" Value="{DynamicResource EditorButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ib" Property="Background" Value="{DynamicResource EditorAccentSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemedComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
        <Setter Property="Background" Value="{DynamicResource EditorFieldBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorFieldBorder}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ThemedComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="cbd" CornerRadius="{StaticResource RadiusCtl}"
                                            Background="{DynamicResource EditorFieldBackground}"
                                            BorderBrush="{DynamicResource EditorFieldBorder}"
                                            BorderThickness="1" SnapsToDevicePixels="True">
                                        <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,11,0" Data="M0,0 L4,4 L8,0"
                                              Stroke="{DynamicResource EditorSecondaryText}" StrokeThickness="1.4" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="cbd" Property="BorderBrush" Value="{DynamicResource EditorBorderStrong}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False" Margin="10,0,26,0"
                                          HorizontalAlignment="Left" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextElement.Foreground="{DynamicResource EditorText}" />
                        <Border x:Name="cbfocus" CornerRadius="{StaticResource RadiusCtl}"
                                Margin="-1" BorderThickness="2" BorderBrush="Transparent"
                                IsHitTestVisible="False" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                               AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                            <Border Margin="0,4,8,8" CornerRadius="{StaticResource RadiusCtl}"
                                    Background="{DynamicResource EditorFieldBackground}"
                                    BorderBrush="{DynamicResource EditorFieldBorder}" BorderThickness="1"
                                    MaxHeight="260"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.32" Color="#000000" />
                                </Border.Effect>
                                <ScrollViewer Margin="2">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="cbfocus" Property="BorderBrush" Value="{DynamicResource EditorAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Slider (RGBA channels) =====================
         Rail Background is TemplateBound so the color picker can paint each channel's gradient
         by setting Slider.Background in code-behind (no template-part lookup needed). -->
    <Style x:Key="ChannelSliderThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse x:Name="glow" Width="18" Height="18" Opacity="0"
                                 Fill="{DynamicResource EditorAccentSubtle}" />
                        <Ellipse Width="14" Height="14"
                                 Fill="{DynamicResource EditorText}"
                                 Stroke="{DynamicResource EditorFieldBackground}" StrokeThickness="2" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="glow" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="glow" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChannelSlider" TargetType="Slider">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="255" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="16" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border CornerRadius="4" Height="8" VerticalAlignment="Center"
                                Background="{StaticResource AlphaCheckerBrush}" />
                        <Border CornerRadius="4" Height="8" VerticalAlignment="Center"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource EditorFieldBorder}" BorderThickness="1" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackRepeatButton}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackRepeatButton}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ChannelSliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Segmented toggle (editor Light | Dark) =====================
         Two styles so each end carries its own outer rounding; the shared frame reads as one
         segmented control. Keyboard focus shows an accent ring (OverridesDefaultStyle drops the
         default focus rect). -->
    <Style x:Key="SegmentItemLeft" TargetType="RadioButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource EditorSecondaryText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorFieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="sb" CornerRadius="6,0,0,6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,0,1" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="sring" CornerRadius="6,0,0,6" Margin="-1"
                                BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="sb" Property="Background" Value="{DynamicResource EditorAccentSubtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource EditorAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="sb" Property="Background" Value="{DynamicResource EditorButtonHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="sring" Property="BorderBrush" Value="{DynamicResource EditorAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SegmentItemRight" TargetType="RadioButton" BasedOn="{StaticResource SegmentItemLeft}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="sb" CornerRadius="0,6,6,0"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="sring" CornerRadius="0,6,6,0" Margin="-1"
                                BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="sb" Property="Background" Value="{DynamicResource EditorAccentSubtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource EditorAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="sb" Property="Background" Value="{DynamicResource EditorButtonHover}" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="sring" Property="BorderBrush" Value="{DynamicResource EditorAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
