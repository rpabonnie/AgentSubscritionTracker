<!-- SPEC-0004 §5.2 — LIGHT editor-chrome brushes for the theme-management windows themselves
     (their OWN look, NOT the theme being edited). Distinct Editor* namespace so it never
     collides with the edited-theme preview keys (CalloutBackgroundBrush, etc.). Must define the
     IDENTICAL key set as EditorChromeDark.xaml so the editor's Light/Dark swap (which replaces
     MergedDictionaries[0] wholesale) never leaves an unresolved DynamicResource.

     Palette: Catppuccin-Latte-derived light surfaces with a single mauve accent, mirroring the
     dark file's layered surface levels. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces (low → high) -->
    <SolidColorBrush x:Key="EditorWindowBackground" Color="#FFEFF1F5" />
    <SolidColorBrush x:Key="EditorPanelBackground" Color="#FFE6E9EF" />
    <SolidColorBrush x:Key="EditorCardBackground" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="EditorFieldBackground" Color="#FFFFFFFF" />

    <!-- Text -->
    <SolidColorBrush x:Key="EditorText" Color="#FF1B1F27" />
    <SolidColorBrush x:Key="EditorSecondaryText" Color="#FF5C6573" />
    <SolidColorBrush x:Key="EditorTertiaryText" Color="#FF9CA3AF" />

    <!-- Borders / dividers -->
    <SolidColorBrush x:Key="EditorFieldBorder" Color="#FFD0D4DC" />
    <SolidColorBrush x:Key="EditorBorderStrong" Color="#FFB0B6C0" />
    <SolidColorBrush x:Key="EditorDivider" Color="#14000000" />

    <!-- Neutral buttons -->
    <SolidColorBrush x:Key="EditorButtonBackground" Color="#FFF6F6F8" />
    <SolidColorBrush x:Key="EditorButtonBorder" Color="#FFD0D4DC" />
    <SolidColorBrush x:Key="EditorButtonHover" Color="#FFE9EAEF" />
    <SolidColorBrush x:Key="EditorButtonPressed" Color="#FFDDDFE6" />

    <!-- Accent (mauve) -->
    <SolidColorBrush x:Key="EditorAccent" Color="#FF8839EF" />
    <SolidColorBrush x:Key="EditorAccentHover" Color="#FF7A2BE0" />
    <SolidColorBrush x:Key="EditorAccentPressed" Color="#FF6D24C9" />
    <SolidColorBrush x:Key="EditorAccentText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="EditorAccentSubtle" Color="#228839EF" />
    <SolidColorBrush x:Key="EditorOnAccentRing" Color="#558839EF" />

    <!-- State -->
    <SolidColorBrush x:Key="EditorOk" Color="#FF2E7D32" />
    <SolidColorBrush x:Key="EditorWarn" Color="#FFB7791F" />
    <SolidColorBrush x:Key="EditorDanger" Color="#FFD13438" />
    <SolidColorBrush x:Key="EditorDangerHover" Color="#FFB52A2E" />
    <SolidColorBrush x:Key="EditorWarnSurface" Color="#1FB7791F" />
    <SolidColorBrush x:Key="EditorDangerSurface" Color="#1FD13438" />

</ResourceDictionary>
