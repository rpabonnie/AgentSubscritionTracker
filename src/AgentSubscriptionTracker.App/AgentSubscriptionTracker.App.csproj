<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.1.2-alpha</Version>
    <RootNamespace>AgentSubscriptionTracker.App</RootNamespace>
    <AssemblyName>AgentSubscriptionTracker.App</AssemblyName>
    <UseWPF>true</UseWPF>
    <!-- Required by the source-generated P/Invoke (LibraryImport) marshalling in
         Services/WindowsCredentialStore.cs (SYSLIB1062) and the fixed-buffer
         NOTIFYICONDATAW interop in Tray/TrayIconHost.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tray icon is loaded from disk at runtime (LoadImageW LR_LOADFROMFILE). -->
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- SPEC-0004 — the 2 built-in theme manifests, embedded so ThemeLoader can re-seed
         them from the assembly even if the on-disk themes folder is missing/corrupt. -->
    <EmbeddedResource Include="Assets\Themes\light.theme.json" LogicalName="AgentSubscriptionTracker.App.Assets.Themes.light.theme.json" />
    <EmbeddedResource Include="Assets\Themes\dark.theme.json" LogicalName="AgentSubscriptionTracker.App.Assets.Themes.dark.theme.json" />
  </ItemGroup>

</Project>
