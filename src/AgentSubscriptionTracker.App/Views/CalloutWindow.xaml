<!-- SPEC-0003 §5.2 / SPEC-0004 §5.2 — borderless, topmost, non-activating tooltip callout.
     Hosts the shared CalloutContent UserControl so the theme editor's live preview can
     render the exact same visuals against a preview-scoped ResourceDictionary. -->
<Window x:Class="AgentSubscriptionTracker.App.Views.CalloutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AgentSubscriptionTracker.App.Views"
        Title="AgentSubscriptionTracker"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <views:CalloutContent x:Name="CalloutContentControl" />
</Window>
