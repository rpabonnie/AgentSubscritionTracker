<!-- SPEC-0004 §5.2 — the callout's visual content, factored out of CalloutWindow.xaml into a
     shared UserControl so the theme editor's live preview can host the exact same visuals
     bound to a preview-scoped ResourceDictionary, never Application.Current.Resources. -->
<UserControl x:Class="AgentSubscriptionTracker.App.Views.CalloutContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:AgentSubscriptionTracker.App.Views"
             xmlns:vm="clr-namespace:AgentSubscriptionTracker.App.ViewModels"
             Width="340">

    <UserControl.Resources>
        <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <views:SeverityToBrushConverter x:Key="SeverityToBrush" />
        <views:BarTrackBrushMultiConverter x:Key="BarTrackBrushBinding" />

        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource BarTrackBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CalloutBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ProviderTemplate" DataType="{x:Type vm:ProviderViewModel}">
            <StackPanel Margin="0,6,0,6">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="{Binding PlanText}"
                               Visibility="{Binding PlanText, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock FontFamily="{DynamicResource HeaderFontFamily}"
                               FontSize="{DynamicResource HeaderFontSize}"
                               FontWeight="{DynamicResource HeaderFontWeight}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Text="{Binding ProviderName}" />
                </DockPanel>

                <TextBlock Margin="0,3,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding StateMessage}"
                           TextWrapping="Wrap"
                           Visibility="{Binding StateMessage, Converter={StaticResource NullToCollapsed}}" />

                <ItemsControl ItemsSource="{Binding Bars}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:UsageBarViewModel}">
                            <Grid Margin="0,5,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0">
                                    <TextBlock DockPanel.Dock="Right"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Text="{Binding ValueText}" />
                                    <TextBlock Foreground="{DynamicResource TextPrimaryBrush}"
                                               Text="{Binding Label}" />
                                </DockPanel>

                                <ProgressBar x:Name="UsageBar"
                                             Grid.Row="1"
                                             Height="4"
                                             Margin="0,3,0,0"
                                             BorderThickness="0"
                                             Maximum="100"
                                             Minimum="0"
                                             Value="{Binding PercentUsed, Mode=OneWay}">
                                    <ProgressBar.Background>
                                        <MultiBinding Converter="{StaticResource BarTrackBrushBinding}">
                                            <Binding RelativeSource="{RelativeSource Self}" />
                                        </MultiBinding>
                                    </ProgressBar.Background>
                                    <ProgressBar.Foreground>
                                        <MultiBinding Converter="{StaticResource SeverityToBrush}">
                                            <Binding Path="Severity" />
                                            <Binding RelativeSource="{RelativeSource Self}" />
                                        </MultiBinding>
                                    </ProgressBar.Foreground>
                                </ProgressBar>

                                <TextBlock Grid.Row="2"
                                           Margin="0,2,0,0"
                                           FontFamily="{DynamicResource FooterFontFamily}"
                                           FontSize="{DynamicResource FooterFontSize}"
                                           FontWeight="{DynamicResource FooterFontWeight}"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Text="{Binding ResetText}"
                                           Visibility="{Binding ResetText, Converter={StaticResource NullToCollapsed}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,5,0,0"
                           FontFamily="{DynamicResource FooterFontFamily}"
                           FontSize="{DynamicResource FooterFontSize}"
                           FontWeight="{DynamicResource FooterFontWeight}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="{Binding FooterText}"
                           Visibility="{Binding FooterText, Converter={StaticResource NullToCollapsed}}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Body fonts are set on the root so all text inherits them by default (SPEC-0004 §5.2 —
         theme fonts now actually drive the callout); header/footer roles override below. -->
    <Border Margin="12"
            Padding="14,10,14,10"
            Background="{DynamicResource CalloutBackgroundPaint}"
            BorderBrush="{DynamicResource CalloutBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            TextElement.FontFamily="{DynamicResource BodyFontFamily}"
            TextElement.FontSize="{DynamicResource BodyFontSize}"
            TextElement.FontWeight="{DynamicResource BodyFontWeight}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Opacity="0.35" ShadowDepth="2" />
        </Border.Effect>

        <StackPanel>
            <TextBlock FontFamily="{DynamicResource HeaderFontFamily}"
                       FontSize="{DynamicResource HeaderFontSize}"
                       FontWeight="{DynamicResource HeaderFontWeight}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="AGENT SUBSCRIPTIONS" />

            <ContentControl Content="{Binding Claude}"
                            ContentTemplate="{StaticResource ProviderTemplate}"
                            Focusable="False" />

            <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}" />

            <ContentControl Content="{Binding Copilot}"
                            ContentTemplate="{StaticResource ProviderTemplate}"
                            Focusable="False" />

            <DockPanel Margin="0,8,0,0" LastChildFill="True">
                <Button x:Name="ThemeButton"
                        Click="OnThemeClick"
                        Content="Theme"
                        DockPanel.Dock="Right"
                        Style="{StaticResource CommandButton}" />
                <Button x:Name="ExitButton"
                        Click="OnExitClick"
                        Content="Exit"
                        DockPanel.Dock="Right"
                        Style="{StaticResource CommandButton}" />
                <Button x:Name="RefreshButton"
                        Click="OnRefreshClick"
                        Content="Refresh"
                        DockPanel.Dock="Right"
                        Style="{StaticResource CommandButton}" />
                <TextBlock x:Name="AgeText"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource FooterFontFamily}"
                           FontSize="{DynamicResource FooterFontSize}"
                           FontWeight="{DynamicResource FooterFontWeight}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
