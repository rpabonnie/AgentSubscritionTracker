<!-- SPEC-0004 §5.1 — non-activating popup listing installed themes: thumbnail + name + Edit
     per row, active theme first then alphabetical with a checkmark indicator, then a
     separated "Add new theme" entry. Borderless/AllowsTransparency, same family of
     behavior as CalloutWindow (ShowActivated=False). -->
<Window x:Class="AgentSubscriptionTracker.App.Views.ThemePickerPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AgentSubscriptionTracker.App.ViewModels"
        Title="Themes"
        Width="220"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    </Window.Resources>

    <Border Margin="8"
            Padding="6"
            Background="{DynamicResource CalloutBackgroundBrush}"
            BorderBrush="{DynamicResource CalloutBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Opacity="0.35" ShadowDepth="2" />
        </Border.Effect>

        <StackPanel>
            <ItemsControl x:Name="ThemeListItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ThemeListEntryViewModel}">
                        <Border Margin="0,2,0,2"
                                Padding="6,4"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel LastChildFill="True" ToolTip="{Binding DisambiguatedDisplayName}">
                                <Button DockPanel.Dock="Right"
                                        Click="OnDeleteClick"
                                        Content="Delete"
                                        Tag="{Binding}" />
                                <Button DockPanel.Dock="Right"
                                        Margin="0,0,4,0"
                                        Click="OnEditClick"
                                        Content="Edit"
                                        Tag="{Binding}" />
                                <TextBlock DockPanel.Dock="Left"
                                           Width="14"
                                           Margin="0,0,4,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Text="✓"
                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVisible}}" />
                                <Button Click="OnSelectClick"
                                        Content="{Binding TruncatedDisplayName}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Tag="{Binding}" />
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="DeleteRefusalMessage"
                       Margin="2,0,2,4"
                       FontSize="11"
                       Foreground="{DynamicResource AccentBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <Rectangle Height="1" Margin="0,4,0,4" Fill="{DynamicResource SeparatorBrush}" />

            <Button Click="OnAddNewThemeClick" Content="Add new theme" HorizontalAlignment="Stretch" />
        </StackPanel>
    </Border>
</Window>
