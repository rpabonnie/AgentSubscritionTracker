<!-- SPEC-0004 §5.1 — non-activating popup listing installed themes. Each row shows a LIVE
     scaled preview of the actual callout rendered in that theme (the shared CalloutContent
     bound to sample data + a row-scoped theme dictionary), a name caption with a checkmark
     for the active theme, and Edit/Delete; clicking a preview selects that theme. Active
     theme first then alphabetical, then a separated "Add new theme" entry. Borderless/
     AllowsTransparency, same family of behavior as CalloutWindow (ShowActivated=False). -->
<Window x:Class="AgentSubscriptionTracker.App.Views.ThemePickerPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AgentSubscriptionTracker.App.Views"
        xmlns:vm="clr-namespace:AgentSubscriptionTracker.App.ViewModels"
        Title="Themes"
        Width="340"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />

        <!-- Borderless button so the whole live preview is one big click target with no
             button chrome drawn around it. -->
        <Style x:Key="PreviewSelectButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            Padding="6"
            Background="{DynamicResource CalloutBackgroundBrush}"
            BorderBrush="{DynamicResource CalloutBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Opacity="0.35" ShadowDepth="2" />
        </Border.Effect>

        <StackPanel>
            <ScrollViewer MaxHeight="620"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ThemeListItems">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ThemeListEntryViewModel}">
                            <Border Margin="0,4"
                                    Padding="6"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <!-- Name caption + per-theme actions. -->
                                    <DockPanel LastChildFill="True"
                                               Margin="0,0,0,4"
                                               ToolTip="{Binding DisambiguatedDisplayName}">
                                        <Button DockPanel.Dock="Right"
                                                Click="OnDeleteClick"
                                                Content="Delete"
                                                FontSize="12"
                                                Tag="{Binding}" />
                                        <Button DockPanel.Dock="Right"
                                                Margin="0,0,4,0"
                                                Click="OnEditClick"
                                                Content="Edit"
                                                FontSize="12"
                                                Tag="{Binding}" />
                                        <TextBlock DockPanel.Dock="Left"
                                                   Width="16"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="✓"
                                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVisible}}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Text="{Binding TruncatedDisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>

                                    <!-- Live, scaled-down callout rendered in this theme. Click to use it. -->
                                    <Button Style="{StaticResource PreviewSelectButton}"
                                            Click="OnSelectClick"
                                            Tag="{Binding}"
                                            ToolTip="Click to use this theme">
                                        <Viewbox Width="260" Stretch="Uniform">
                                            <views:CalloutContent Loaded="OnPreviewLoaded" IsHitTestVisible="False" />
                                        </Viewbox>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="DeleteRefusalMessage"
                       Margin="2,4,2,0"
                       FontSize="11"
                       Foreground="{DynamicResource AccentBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <Rectangle Height="1" Margin="0,6,0,4" Fill="{DynamicResource SeparatorBrush}" />

            <Button Click="OnAddNewThemeClick" Content="Add new theme" HorizontalAlignment="Stretch" />
        </StackPanel>
    </Border>
</Window>
