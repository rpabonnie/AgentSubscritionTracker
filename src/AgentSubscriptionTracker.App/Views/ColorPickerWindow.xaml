<!-- SPEC-0004 §5.2 — a small self-contained RGBA color picker for the theme editor's color
     fields, so users don't have to know hex by heart. WPF-only (no WinForms dependency) and
     supports alpha. Returns the chosen color via ColorPickerWindow.SelectedColor.

     Chrome: shares the design system (App-merged keyed styles) + an Editor* chrome dictionary
     inserted at MergedDictionaries[0] by the caller so it mirrors the editor's Light/Dark look.
     Per-channel slider tracks are painted from code-behind via Slider.Background. -->
<Window x:Class="AgentSubscriptionTracker.App.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a color"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource EditorWindowBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Shared design system (tokens + keyed control templates). The caller inserts
                     an Editor* chrome dictionary at index 0 in code-behind to mirror the editor's
                     Light/Dark look. -->
                <ResourceDictionary Source="/Themes/EditorDesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource WindowPad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Preview swatch (over a checkerboard so alpha reads) + hex readout. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18" LastChildFill="True">
            <Grid Width="76" Height="46" DockPanel.Dock="Left">
                <Border CornerRadius="{StaticResource RadiusSwatch}" Background="{StaticResource AlphaCheckerBrush}" />
                <Rectangle x:Name="PreviewSwatch" RadiusX="5" RadiusY="5" />
                <Border CornerRadius="{StaticResource RadiusSwatch}"
                        BorderBrush="{DynamicResource EditorFieldBorder}" BorderThickness="1" />
            </Grid>
            <TextBlock x:Name="HexText" VerticalAlignment="Center" Margin="16,0,0,0"
                       FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="20"
                       Foreground="{DynamicResource EditorText}" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,4">
            <TextBlock DockPanel.Dock="Left" Width="20" Text="R" VerticalAlignment="Center"
                       Foreground="{DynamicResource EditorSecondaryText}" />
            <TextBlock x:Name="RValue" DockPanel.Dock="Right" Width="36" TextAlignment="Right"
                       VerticalAlignment="Center" Foreground="{DynamicResource EditorText}" />
            <Slider x:Name="RSlider" Style="{StaticResource ChannelSlider}" Margin="6,0"
                    VerticalAlignment="Center" ValueChanged="OnChannelChanged" />
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,4">
            <TextBlock DockPanel.Dock="Left" Width="20" Text="G" VerticalAlignment="Center"
                       Foreground="{DynamicResource EditorSecondaryText}" />
            <TextBlock x:Name="GValue" DockPanel.Dock="Right" Width="36" TextAlignment="Right"
                       VerticalAlignment="Center" Foreground="{DynamicResource EditorText}" />
            <Slider x:Name="GSlider" Style="{StaticResource ChannelSlider}" Margin="6,0"
                    VerticalAlignment="Center" ValueChanged="OnChannelChanged" />
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,4">
            <TextBlock DockPanel.Dock="Left" Width="20" Text="B" VerticalAlignment="Center"
                       Foreground="{DynamicResource EditorSecondaryText}" />
            <TextBlock x:Name="BValue" DockPanel.Dock="Right" Width="36" TextAlignment="Right"
                       VerticalAlignment="Center" Foreground="{DynamicResource EditorText}" />
            <Slider x:Name="BSlider" Style="{StaticResource ChannelSlider}" Margin="6,0"
                    VerticalAlignment="Center" ValueChanged="OnChannelChanged" />
        </DockPanel>

        <DockPanel Grid.Row="4" Margin="0,4">
            <TextBlock DockPanel.Dock="Left" Width="20" Text="A" VerticalAlignment="Center"
                       Foreground="{DynamicResource EditorSecondaryText}" />
            <TextBlock x:Name="AValue" DockPanel.Dock="Right" Width="36" TextAlignment="Right"
                       VerticalAlignment="Center" Foreground="{DynamicResource EditorText}" />
            <Slider x:Name="ASlider" Style="{StaticResource ChannelSlider}" Margin="6,0"
                    VerticalAlignment="Center" ValueChanged="OnChannelChanged" />
        </DockPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource SubtleButton}" Click="OnCancel"
                    MinWidth="88" IsCancel="True" />
            <Button Content="OK" Style="{StaticResource AccentButton}" Click="OnOk"
                    Margin="10,0,0,0" MinWidth="88" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
