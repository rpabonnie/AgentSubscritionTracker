<!-- SPEC-0004 §5.2 — a small self-contained RGBA color picker for the theme editor's color
     fields, so users don't have to know hex by heart. WPF-only (no WinForms dependency) and
     supports alpha. Returns the chosen color via ColorPickerWindow.SelectedColor. -->
<Window x:Class="AgentSubscriptionTracker.App.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a color"
        Width="340"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14" LastChildFill="True">
            <Border Width="72" Height="44" DockPanel.Dock="Left"
                    BorderBrush="#888888" BorderThickness="1" CornerRadius="3">
                <Rectangle x:Name="PreviewSwatch" />
            </Border>
            <TextBlock x:Name="HexText" VerticalAlignment="Center" Margin="14,0,0,0"
                       FontFamily="Consolas" FontSize="18" />
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,3">
            <TextBlock DockPanel.Dock="Left" Width="20" Text="R" VerticalAlignment="Center" />
            <TextBlock x:Name="RValue" DockPanel.Dock="Right" Width="36" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider x:Name="RSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                    ValueChanged="OnChannelChanged" />
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,3">
            <TextBlock DockPanel.Dock="Left" Width="20" Text="G" VerticalAlignment="Center" />
            <TextBlock x:Name="GValue" DockPanel.Dock="Right" Width="36" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider x:Name="GSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                    ValueChanged="OnChannelChanged" />
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,3">
            <TextBlock DockPanel.Dock="Left" Width="20" Text="B" VerticalAlignment="Center" />
            <TextBlock x:Name="BValue" DockPanel.Dock="Right" Width="36" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider x:Name="BSlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                    ValueChanged="OnChannelChanged" />
        </DockPanel>

        <DockPanel Grid.Row="4" Margin="0,3">
            <TextBlock DockPanel.Dock="Left" Width="20" Text="A" VerticalAlignment="Center" />
            <TextBlock x:Name="AValue" DockPanel.Dock="Right" Width="36" TextAlignment="Right" VerticalAlignment="Center" />
            <Slider x:Name="ASlider" Minimum="0" Maximum="255" SmallChange="1" LargeChange="16"
                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                    ValueChanged="OnChannelChanged" />
        </DockPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Click="OnCancel" Padding="16,4" IsCancel="True" />
            <Button Content="OK" Click="OnOk" Margin="8,0,0,0" Padding="16,4" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
