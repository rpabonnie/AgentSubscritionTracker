<!-- SPEC-0004 §5.2 — theme editor: a real, activatable window (keyboard focus for typed
     inputs). Hosts the shared CalloutContent live preview bound to a preview-scoped
     ResourceDictionary; edits never touch Application.Current.Resources until Save.

     Chrome look comes from the shared design system (App-merged EditorDesignSystem.xaml, keyed
     styles) + the swappable Editor* brushes at Window.Resources MergedDictionaries[0]. All
     editor control styles are applied EITHER explicitly (buttons, hex fields) OR as scoped
     implicit styles inside the left ScrollViewer.Resources, so none of them reach the preview
     CalloutContent in the right column — it must keep rendering the *edited* theme. -->
<Window x:Class="AgentSubscriptionTracker.App.Views.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AgentSubscriptionTracker.App.Views"
        Title="Edit theme"
        Width="1000"
        Height="780"
        MinWidth="760"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="{DynamicResource EditorWindowBackground}">

    <!-- SPEC-0004 §5.2 — editor-chrome theming (the editor window's OWN look, NOT the theme
         being edited). The chrome dictionary lives at index 0 of Window.Resources.Merged-
         Dictionaries so the toggle handler can replace it. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- App-root-absolute pack URI (leading slash). A relative "Themes/..." here
                     resolves against this file's /Views/ base URI and throws at load. Index 0 is
                     the swappable chrome (the Light/Dark toggle replaces it); the design system
                     (tokens + keyed control templates) stays at index 1, untouched by the swap. -->
                <ResourceDictionary Source="/Themes/EditorChromeDark.xaml" />
                <ResourceDictionary Source="/Themes/EditorDesignSystem.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="{StaticResource WindowPad}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar row: title + editor-appearance segmented toggle (SPEC-0004 §5.2). The
             toggle re-themes the editor's own chrome only; the preview keeps the edited theme. -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TextTitle}"
                       VerticalAlignment="Center" Text="Edit theme" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TextCaption}" VerticalAlignment="Center"
                           Margin="0,0,10,0" Text="Editor appearance" />
                <RadioButton x:Name="LightChromeRadio"
                             GroupName="EditorChrome"
                             Style="{StaticResource SegmentItemLeft}"
                             Content="Light"
                             Checked="OnEditorChromeChanged" />
                <RadioButton x:Name="DarkChromeRadio"
                             GroupName="EditorChrome"
                             Style="{StaticResource SegmentItemRight}"
                             Content="Dark"
                             IsChecked="True"
                             Checked="OnEditorChromeChanged" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" Margin="0,0,16,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,8,0">
                <!-- Scoped chrome: implicit styles re-theme only the editor's own controls (BasedOn
                     the shared keyed bases), never the preview CalloutContent in the right column. -->
                <ScrollViewer.Resources>
                    <views:HexToBrushConverter x:Key="HexToBrush" />

                    <Style TargetType="TextBlock" BasedOn="{StaticResource TextBody}" />
                    <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}" />
                    <Style TargetType="ComboBox" BasedOn="{StaticResource ThemedComboBox}" />
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                </ScrollViewer.Resources>

                <StackPanel Grid.IsSharedSizeScope="True">

                    <!-- Identity -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextSectionHeader}" Text="Identity" />
                            <TextBlock Margin="{StaticResource LabelToFieldGap}" Text="Name" />
                            <TextBox x:Name="NameBox" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Border>

                    <!-- Background -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextSectionHeader}" Text="Background" />

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PickImageButton" Style="{StaticResource SubtleButton}"
                                        Click="OnPickImageClick" Content="Choose image…" />
                                <Button x:Name="ClearImageButton" Style="{StaticResource SubtleButton}"
                                        Click="OnClearImageClick" Content="Clear" Margin="8,0,0,0" />
                                <TextBlock x:Name="ImagePathText" Style="{StaticResource TextCaption}"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource TextCaption}" Margin="0,8,0,0"
                                       Text="PNG with transparency (alpha) required. Recommended at least 360 × 440 px to cover the callout — use 2× (≈720 × 880 px) for sharp high-DPI displays. Maximum 8192 × 8192 px and 30 MB." />

                            <TextBlock Margin="0,14,0,4" Text="Fallback color (#AARRGGBB or #RRGGBB)" />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconSwatchButton}" Click="OnPickColor"
                                        VerticalAlignment="Center"
                                        Tag="{Binding ElementName=FallbackColorBox}"
                                        Background="{Binding Text, ElementName=FallbackColorBox, Converter={StaticResource HexToBrush}}" />
                                <TextBox x:Name="FallbackColorBox" Style="{StaticResource HexBox}"
                                         Margin="10,0,0,0" TextChanged="OnAnyFieldChanged" />
                            </StackPanel>

                            <Border x:Name="ImportErrorBanner" Visibility="Collapsed" Margin="0,10,0,0"
                                    CornerRadius="{StaticResource RadiusCtl}" Padding="10,6"
                                    Background="{DynamicResource EditorDangerSurface}">
                                <TextBlock x:Name="ImportErrorText" Style="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource EditorDanger}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Typography -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextSectionHeader}" Text="Typography" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Header" />
                                <ComboBox x:Name="HeaderFontCombo" Grid.Column="2" MaxWidth="240"
                                          HorizontalAlignment="Left" MinWidth="180"
                                          SelectionChanged="OnAnyFieldChanged" />
                                <TextBox x:Name="HeaderFontSizeBox" Grid.Column="4" Style="{StaticResource FontSizeBox}"
                                         TextChanged="OnAnyFieldChanged" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Body" />
                                <ComboBox x:Name="BodyFontCombo" Grid.Column="2" MaxWidth="240"
                                          HorizontalAlignment="Left" MinWidth="180"
                                          SelectionChanged="OnAnyFieldChanged" />
                                <TextBox x:Name="BodyFontSizeBox" Grid.Column="4" Style="{StaticResource FontSizeBox}"
                                         TextChanged="OnAnyFieldChanged" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Footer" />
                                <ComboBox x:Name="FooterFontCombo" Grid.Column="2" MaxWidth="240"
                                          HorizontalAlignment="Left" MinWidth="180"
                                          SelectionChanged="OnAnyFieldChanged" />
                                <TextBox x:Name="FooterFontSizeBox" Grid.Column="4" Style="{StaticResource FontSizeBox}"
                                         TextChanged="OnAnyFieldChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Brush colors -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextSectionHeader}" Text="Brush colors" />
                            <TextBlock Style="{StaticResource TextCaption}" Margin="0,-6,0,12"
                                       Text="Each value is #AARRGGBB or #RRGGBB. Click a swatch to pick visually." />

                            <StackPanel>
                                <!-- Callout background -->
                                <Grid Margin="{StaticResource RowGap}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Callout background" />
                                    <Button Grid.Column="2" Style="{StaticResource IconSwatchButton}"
                                            VerticalAlignment="Center" Click="OnPickColor"
                                            Tag="{Binding ElementName=CalloutBackgroundBrushBox}"
                                            Background="{Binding Text, ElementName=CalloutBackgroundBrushBox, Converter={StaticResource HexToBrush}}" />
                                    <TextBox x:Name="CalloutBackgroundBrushBox" Grid.Column="4"
                                             Style="{StaticResource HexBox}" TextChanged="OnAnyFieldChanged" />
                                </Grid>

                                <!-- Callout border -->
                                <Grid Margin="{StaticResource RowGap}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Callout border" />
                                    <Button Grid.Column="2" Style="{StaticResource IconSwatchButton}"
                                            VerticalAlignment="Center" Click="OnPickColor"
                                            Tag="{Binding ElementName=CalloutBorderBrushBox}"
                                            Background="{Binding Text, ElementName=CalloutBorderBrushBox, Converter={StaticResource HexToBrush}}" />
                                    <TextBox x:Name="CalloutBorderBrushBox" Grid.Column="4"
                                             Style="{StaticResource HexBox}" TextChanged="OnAnyFieldChanged" />
                                </Grid>

                                <!-- Primary text -->
                                <Grid Margin="{StaticResource RowGap}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Primary text" />
                                    <Button Grid.Column="2" Style="{StaticResource IconSwatchButton}"
                                            VerticalAlignment="Center" Click="OnPickColor"
                                            Tag="{Binding ElementName=TextPrimaryBrushBox}"
                                            Background="{Binding Text, ElementName=TextPrimaryBrushBox, Converter={StaticResource HexToBrush}}" />
                                    <TextBox x:Name="TextPrimaryBrushBox" Grid.Column="4"
                                             Style="{StaticResource HexBox}" TextChanged="OnAnyFieldChanged" />
                                </Grid>

                                <!-- Secondary text -->
                                <Grid Margin="{StaticResource RowGap}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Secondary text" />
                                    <Button Grid.Column="2" Style="{StaticResource IconSwatchButton}"
                                            VerticalAlignment="Center" Click="OnPickColor"
                                            Tag="{Binding ElementName=TextSecondaryBrushBox}"
                                            Background="{Binding Text, ElementName=TextSecondaryBrushBox, Converter={StaticResource HexToBrush}}" />
                                    <TextBox x:Name="TextSecondaryBrushBox" Grid.Column="4"
                                             Style="{StaticResource HexBox}" TextChanged="OnAnyFieldChanged" />
                                </Grid>

                                <!-- Bar track -->
                                <Grid Margin="{StaticResource RowGap}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Bar track" />
                                    <Button Grid.Column="2" Style="{StaticResource IconSwatchButton}"
                                            VerticalAlignment="Center" Click="OnPickColor"
                                            Tag="{Binding ElementName=BarTrackBrushBox}"
                                            Background="{Binding Text, ElementName=BarTrackBrushBox, Converter={StaticResource HexToBrush}}" />
                                    <TextBox x:Name="BarTrackBrushBox" Grid.Column="4"
                                             Style="{StaticResource HexBox}" TextChanged="OnAnyFieldChanged" />
                                </Grid>

                                <!-- Separator -->
                                <Grid Margin="{StaticResource RowGap}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Separator" />
                                    <Button Grid.Column="2" Style="{StaticResource IconSwatchButton}"
                                            VerticalAlignment="Center" Click="OnPickColor"
                                            Tag="{Binding ElementName=SeparatorBrushBox}"
                                            Background="{Binding Text, ElementName=SeparatorBrushBox, Converter={StaticResource HexToBrush}}" />
                                    <TextBox x:Name="SeparatorBrushBox" Grid.Column="4"
                                             Style="{StaticResource HexBox}" TextChanged="OnAnyFieldChanged" />
                                </Grid>

                                <!-- Accent -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Accent" />
                                    <Button Grid.Column="2" Style="{StaticResource IconSwatchButton}"
                                            VerticalAlignment="Center" Click="OnPickColor"
                                            Tag="{Binding ElementName=AccentBrushBox}"
                                            Background="{Binding Text, ElementName=AccentBrushBox, Converter={StaticResource HexToBrush}}" />
                                    <TextBox x:Name="AccentBrushBox" Grid.Column="4"
                                             Style="{StaticResource HexBox}" TextChanged="OnAnyFieldChanged" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Severity colors -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TextSectionHeader}" Text="Severity colors" />

                            <Grid Margin="{StaticResource RowGap}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Ok" />
                                <Button Grid.Column="2" Style="{StaticResource IconSwatchButton}"
                                        VerticalAlignment="Center" Click="OnPickColor"
                                        Tag="{Binding ElementName=SeverityOkBox}"
                                        Background="{Binding Text, ElementName=SeverityOkBox, Converter={StaticResource HexToBrush}}" />
                                <TextBox x:Name="SeverityOkBox" Grid.Column="4"
                                         Style="{StaticResource HexBox}" TextChanged="OnAnyFieldChanged" />
                            </Grid>

                            <Grid Margin="{StaticResource RowGap}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Warn" />
                                <Button Grid.Column="2" Style="{StaticResource IconSwatchButton}"
                                        VerticalAlignment="Center" Click="OnPickColor"
                                        Tag="{Binding ElementName=SeverityWarnBox}"
                                        Background="{Binding Text, ElementName=SeverityWarnBox, Converter={StaticResource HexToBrush}}" />
                                <TextBox x:Name="SeverityWarnBox" Grid.Column="4"
                                         Style="{StaticResource HexBox}" TextChanged="OnAnyFieldChanged" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="EditorLabel" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Critical" />
                                <Button Grid.Column="2" Style="{StaticResource IconSwatchButton}"
                                        VerticalAlignment="Center" Click="OnPickColor"
                                        Tag="{Binding ElementName=SeverityCriticalBox}"
                                        Background="{Binding Text, ElementName=SeverityCriticalBox, Converter={StaticResource HexToBrush}}" />
                                <TextBox x:Name="SeverityCriticalBox" Grid.Column="4"
                                         Style="{StaticResource HexBox}" TextChanged="OnAnyFieldChanged" />
                            </Grid>

                            <Border x:Name="ContrastWarningBanner" Visibility="Collapsed" Margin="0,12,0,0"
                                    CornerRadius="{StaticResource RadiusCtl}" Padding="10,6"
                                    Background="{DynamicResource EditorWarnSurface}">
                                <TextBlock x:Name="ContrastWarningText" Style="{StaticResource TextCaption}"
                                           Foreground="{DynamicResource EditorWarn}" />
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Live preview pane -->
            <Border Grid.Column="1"
                    Background="{DynamicResource EditorPanelBackground}"
                    BorderBrush="{DynamicResource EditorDivider}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusCard}"
                    Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource TextCaption}" Margin="2,0,0,8" Text="LIVE PREVIEW" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                        <views:CalloutContent x:Name="PreviewContent" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource SubtleButton}"
                    Click="OnCancelClick" Content="Cancel" MinWidth="92" />
            <Button x:Name="SaveButton" Style="{StaticResource AccentButton}"
                    Click="OnSaveClick" Content="Save theme" Margin="10,0,0,0" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
