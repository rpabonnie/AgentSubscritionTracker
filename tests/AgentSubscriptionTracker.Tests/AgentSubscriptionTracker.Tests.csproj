<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <!-- Test code is not shipped/externally-visible product surface; CAxxxx analyzer
         rules tuned for public API hygiene (CA1054 Uri params, CA1062 null-checks on
         theory data, CA1307/CA1308 culture-explicit string ops) add noise without value
         in xUnit [Theory]/test-only helper methods. Keep TreatWarningsAsErrors for genuine
         compiler warnings; only relax the design/globalization analyzer categories here. -->
    <NoWarn>$(NoWarn);CA1031;CA1054;CA1062;CA1307;CA1308;CA1859</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF removes these from the SDK's implicit usings; the test stubs rely on them. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentSubscriptionTracker.App\AgentSubscriptionTracker.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden-file JSON fixtures (fake tokens only) used by SPEC test stubs. -->
    <None Update="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- SPEC-0004 background-image fixtures (synthetic PNGs, no real user content). -->
    <None Update="Fixtures\**\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
